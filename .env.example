# Còpia aquest fitxer a .env i omple els valors.
# NO pujis mai .env a GitHub.

# --- Mongo local (Docker Compose) ---
MONGO_USER=caliu
MONGO_PASSWORD=canvia_aquesta_contrasenya
MONGO_DB=caliu

# Port públic de l'API (host)
NODE_PORT=3000

# JWT (auth futura). Qualsevol string llarg en local.
JWT_SECRET=canvia_aquest_secret_local

# URL interna del python-service dins Docker
PYTHON_SERVICE_URL=http://python-service:8000

# --- Opcional: MongoDB Atlas (dades reals / trigger) ---
# Si es defineix, api-node i python-service usen Atlas en lloc del mongo del compose.
# Inclou el nom de la BD al path, p. ex. .../Caliu?retryWrites=true&w=majority
# API_MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/Caliu?retryWrites=true&w=majority

# --- python-service (opcional) ---
# GEMINI_API_KEY=
