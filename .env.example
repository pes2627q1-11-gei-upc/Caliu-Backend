# Copia a .env i omple els camps buits localment. No comparteixis secrets.
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=caliu
JWT_SECRET=
JWT_TTL_SECONDS=3600
NODE_PORT=3000
PYTHON_SERVICE_URL=http://python-service:8000
# Orígens que poden cridar l'API des del navegador (Flutter Web), separats per comes.
# Buit = CORS desactivat. L'app Android no en depèn.
CORS_ORIGINS=http://localhost:5000
GEMINI_API_KEY=
SOURCE_MONGO_URI=
SOURCE_DB=
SOURCE_COLLECTION=
# Execució de Node fora de Docker (no es llegeix automàticament).
MONGO_URI=
PORT=3000

# Opcional: Atlas en lloc del Mongo local de Docker Compose.
# Inclou el nom de la BD al path de la URI.
# API_MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/Caliu?retryWrites=true&w=majority
