# Copia a .env i omple els camps buits localment. No comparteixis secrets.
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=caliu
# Base usada si MONGO_URI no especifica una base de datos.
MONGO_DATABASE=caliu
# development permite eventos seed; usa production para excluirlos.
APP_ENV=production
JWT_SECRET=
JWT_TTL_SECONDS=3600
NODE_PORT=3000
PYTHON_SERVICE_URL=http://python-service:8000
# Temps màxim d'espera del proxy cap a Python (mil·lisegons; per defecte 60000).
PYTHON_TIMEOUT_MS=60000
# Orígens que poden cridar l'API des del navegador (Flutter Web), separats per comes.
# Buit = CORS desactivat. L'app Android no en depèn.
CORS_ORIGINS=http://localhost:5000
# Claus de l'API externa per a altres equips (p. ex. Xematrip): "nom:clau" separats per comes,
# claus d'almenys 32 caràcters. Buit = API externa tancada. No les pugis al repositori.
EXTERNAL_API_KEYS=
# Servei de mobilitat de WayGo per a la secció «Com arribar-hi» (GET /events/{id}/mobility).
# URL base que ens dona WayGo i la clau de Caliu. Buit = secció desactivada. No pugis la clau al repositori.
WAYGO_API_URL=
WAYGO_API_KEY=
# Opcional: temps màxim de la crida a WayGo (ms, per defecte 5000).
WAYGO_TIMEOUT_MS=
# Clau de l'API de Gemini per al xatbot. No la pugis al repositori.
GEMINI_API_KEY=
# Opcional: model Gemini (per defecte gemini-3.8-flash).
GEMINI_MODEL=
# Opcional: temps màxim de cada crida a Gemini (ms, per defecte 15000) i reintents de la resposta del xat
# (per defecte 1). Mantingueu extracció + reintents per sota de PYTHON_TIMEOUT_MS.
GEMINI_TIMEOUT_MS=
GEMINI_RETRIES=
SOURCE_MONGO_URI=
SOURCE_DB=
SOURCE_COLLECTION=
# Execució de Node fora de Docker (no es llegeix automàticament).
MONGO_URI=
PORT=3000

# Opcional: Atlas en lloc del Mongo local de Docker Compose.
# Inclou el nom de la BD al path de la URI.
# API_MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/caliu?retryWrites=true&w=majority

# URL del backend accessible des del client (per als avatars).
PUBLIC_API_URL=http://localhost:3000
