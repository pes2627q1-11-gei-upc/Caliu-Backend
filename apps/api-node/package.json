{
  "name": "caliu-api-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testRegex=users.integration.js$",
    "users:audit": "node src/scripts/auditUsers.js",
    "recommender:weights": "node src/scripts/recommenderWeights.js",
    "seed": "node src/scripts/seed.js",
    "seed:clear": "node src/scripts/seed.js --clear"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80
      }
    }
  }
}
